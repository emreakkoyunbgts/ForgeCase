{
  "openapi": "3.1.0",
  "info": {
    "title": "CaseForge Verifier",
    "version": "1.0.0"
  },
  "paths": {
    "/verify": {
      "post": {
        "summary": "Verify Draft",
        "description": "Return PASS/BLOCK and problems using the requested source from Vault.",
        "operationId": "verify_draft_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/verify/{record_id}": {
      "post": {
        "summary": "Verify Record Id",
        "description": "Compatibility for Console/Publisher; submitted record facts are never trusted.",
        "operationId": "verify_record_id_verify__record_id__post",
        "deprecated": true,
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Record Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LegacyVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Liveness only; source availability is checked by each verification request.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LegacyVerifyRequest": {
        "properties": {
          "record": {
            "additionalProperties": true,
            "type": "object",
            "title": "Record"
          },
          "mcs": {
            "additionalProperties": true,
            "type": "object",
            "title": "Mcs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "record",
          "mcs"
        ],
        "title": "LegacyVerifyRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerificationReport": {
        "properties": {
          "engagement_id": {
            "type": "string",
            "title": "Engagement Id"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "PASS",
              "BLOCK"
            ],
            "title": "Verdict"
          },
          "problems": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Problems"
          }
        },
        "type": "object",
        "required": [
          "engagement_id",
          "verdict",
          "problems"
        ],
        "title": "VerificationReport"
      },
      "VerifyRequest": {
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1,
            "title": "Record Id"
          },
          "draft": {
            "additionalProperties": true,
            "type": "object",
            "title": "Draft"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "de",
              "tr"
            ],
            "title": "Language",
            "default": "en"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "record_id",
          "draft"
        ],
        "title": "VerifyRequest"
      }
    }
  }
}
