# Copy this file to .env and fill in your key.
# .env is gitignored — the key must NEVER be committed. Ask your mentor for it.
ANTHROPIC_API_KEY=

# CF-85 — the shared service token for calls between our HTTP services.
# Vault requires `Authorization: Bearer <this value>` on every data endpoint
# once it is set; leave it empty while wiring and Vault serves unauthenticated.
CASEFORGE_TOKEN=
