LIBRARIAN_URL=http://127.0.0.1:8002
READER_URL=http://127.0.0.1:8003
VERIFIER_URL=http://127.0.0.1:8004
PUBLISHER_URL=http://127.0.0.1:8005
ANALYST_URL=http://127.0.0.1:8007
